# =====================================================================
#  SmartXonnect Plus — secrets / device config
#  Copy this file to  secrets.properties  and fill in YOUR values.
#  secrets.properties is gitignored and never committed.
#  These feed BuildConfig at compile time (see app/build.gradle.kts).
# =====================================================================

# ---- Keyless BLE protocol (from YOUR decompiled app / your bike) ----
# 16-byte AES key as hex (KeylessEntryUtils.AES_KEY_BYTE_ARRAY)
AES_KEY_HEX=00000000000000000000000000000000
# XOR layer key byte, decimal. 0xEB = 235
XOR_KEY_BYTE=235

# 16-byte command seeds as hex (from your extracted_command_constants.json)
SEED_FIND_VEHICLE=00000000000000000000000000000000
SEED_LOCK=00000000000000000000000000000000
SEED_UNLOCK=00000000000000000000000000000000
SEED_OPEN_TRUNK=00000000000000000000000000000000

# GATT characteristic UUIDs (defaults match TVSBT/U388 series)
UUID_WRITE=00005352-0000-1000-8000-00805f9b34fb
UUID_NOTIFY=00005354-0000-1000-8000-00805f9b34fb

# Optional app bootstrap preamble, comma-separated 20-byte hex frames.
# Leave empty to skip. Example (yours from test.txt):
# BOOTSTRAP_FRAMES=5af1030900020000000f02ea01010000000000ff,5b4a2350280004150b0100000f031a00010100ff
BOOTSTRAP_FRAMES=

# ---- Cloud endpoints (defaults are the real TVS prod hosts) ----
BASE_URL_ICE=https://tvsconnectapi.tvsmotor.com/api/
BASE_URL_EV=https://tvsiqubeapi.tvsmotor.com/api/
GRAPHQL_URL=https://p360.tvsmotor.com/gapi
